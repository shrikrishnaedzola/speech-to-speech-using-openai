# Copy this file to .env and fill in real values. .env is git-ignored.

# Your OpenAI project API key. Stays on the backend, never sent to the browser.
OPENAI_API_KEY=sk-your-key-here

# Models under test
LIVE_MODEL=gpt-live-1
REALTIME_MODEL=gpt-realtime-2.1

# GPT-Live delegates tool calls to a Responses model (see README).
LIVE_DELEGATE_MODEL=gpt-5.6-terra

# Transcription model used for caller transcripts with gpt-realtime-2.1
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Cost estimate rates in USD per minute (editable in the UI too)
COST_PER_MIN_LIVE=0.05
COST_PER_MIN_REALTIME=0.10
# GPT-Live bills 15 seconds when a WebRTC session is created
LIVE_INIT_SECONDS=15

# SQLite file (relative to backend/)
DATABASE_URL=sqlite:///./data/app.db
